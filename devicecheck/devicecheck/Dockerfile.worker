FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json* ./
COPY prisma ./prisma/
RUN npm install
RUN npx prisma generate

COPY . .

RUN mkdir -p /app/reports

CMD ["sh", "-c", "node node_modules/prisma/build/index.js migrate deploy && npm run worker"]
